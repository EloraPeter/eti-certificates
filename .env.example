# Same Supabase project as ETI-cohort — same values as that repo's
# environment. This app has its own deployment (its own Vercel
# project / environment variables), but points at the SAME project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the client. Grants full access to
# the entire shared Supabase project (not just certificate tables) —
# see README.md "Service-role security" section before touching this.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only admin allow-list for THIS app. Deliberately NOT
# NEXT_PUBLIC_* (ETI-cohort uses NEXT_PUBLIC_ADMIN_EMAILS; this repo
# uses a server-only variable instead — see AUTHENTICATION section
# of README.md for why that's a deliberate deviation, not an
# oversight). Comma-separated emails.
ADMIN_EMAILS=you@eloratechinstitute.com

# This app's own deployed domain. Used to build the verification URL
# embedded in QR codes.
NEXT_PUBLIC_SITE_URL=https://certificates.eloratechinstitute.com
